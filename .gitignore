# 忽略编译目录
build/
build-release/
cmake-build-debug/

# 忽略日志文件
logs/
*.log
.demo_run/

# 忽略 IDE 配置（如果你用 VSCode 或 CLion）
.vscode/
.idea/

# 忽略系统文件
.DS_Store

# 忽略临时二进制文件（如果有）
*.o
*.a
*.so

# 忽略 Python 运行缓存
__pycache__/
*.py[cod]

# Ignore large masstree benchmark datasets and outputs
masstree/Bplustreetest/txt/file_info.txt
masstree/Bplustreetest/txt/filename.txt
masstree/Bplustreetest/txt/1000user*.txt
masstree/Bplustreetest/txt/output*.txt
masstree/build_user/

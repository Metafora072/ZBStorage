# 忽略编译目录
build/
build-release/
cmake-build-debug/

# 忽略日志文件
logs/
*.log
.demo_run/

# 忽略各测试模块生成的结果和日志
tests/*/results/

# 忽略 IDE 配置（如果你用 VSCode 或 CLion）
.vscode/
.idea/

# 忽略系统文件
.DS_Store

# 忽略临时二进制文件（如果有）
*.o
*.a
*.so

# 忽略 Python 运行缓存
__pycache__/
*.py[cod]

# Per-module raw test logs (test results are ignored separately).
tests/*/log/

# Local experiment reports are evidence, not source deliverables.
tests/scheduler/REPORT-*.md
# Internal regression sources remain local; deliver runnable task experiments only.
/tests/scheduler/cpp/
/tests/scheduler/python/test_*.py
/tests/scheduler/python/closure.py
/tools/workload_trace/tests/
/docs/experiments/scheduler-formal-validation-20260803.md
/docs/experiments/scheduler-node-management-cms-closure-20260903.md

# Ignore large masstree benchmark datasets and outputs
masstree/Bplustreetest/txt/file_info.txt
masstree/Bplustreetest/txt/filename.txt
masstree/Bplustreetest/txt/1000user*.txt
masstree/Bplustreetest/txt/output*.txt
masstree/build_user/
